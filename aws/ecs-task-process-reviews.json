{
  "family": "matetrip-process-reviews",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "2048",
  "memory": "4096",
  "executionRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskExecutionRole",
  "taskRoleArn": "arn:aws:iam::YOUR_ACCOUNT_ID:role/ecsTaskRole",
  "containerDefinitions": [
    {
      "name": "matetrip-review-processor",
      "image": "YOUR_ACCOUNT_ID.dkr.ecr.ap-northeast-2.amazonaws.com/matetrip-ai:latest",
      "essential": true,
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/matetrip-process-reviews",
          "awslogs-region": "ap-northeast-2",
          "awslogs-stream-prefix": "ecs"
        }
      },
      "environment": [
        {
          "name": "AWS_REGION",
          "value": "ap-northeast-2"
        },
        {
          "name": "MODEL_ID",
          "value": "amazon.titan-embed-text-v2:0"
        },
        {
          "name": "DB_DEBUG",
          "value": "False"
        },
        {
          "name": "TOKENIZERS_PARALLELISM",
          "value": "false"
        },
        {
          "name": "OPENAI_MODEL",
          "value": "gpt-4o-mini"
        },
        {
          "name": "OPENAI_EMBEDDING_MODEL",
          "value": "text-embedding-3-small"
        },
        {
          "name": "NAVER_BLOG_SEARCH_URL",
          "value": "https://openapi.naver.com/v1/search/blog.json"
        },
        {
          "name": "BATCH_INDEX",
          "value": "0"
        },
        {
          "name": "TOTAL_BATCHES",
          "value": "7"
        }
      ],
      "secrets": [
        {
          "name": "DB_HOST",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/db:DB_HOST::"
        },
        {
          "name": "DB_PORT",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/db:DB_PORT::"
        },
        {
          "name": "DB_USER",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/db:DB_USER::"
        },
        {
          "name": "DB_PASSWORD",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/db:DB_PASSWORD::"
        },
        {
          "name": "DB_NAME",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/db:DB_NAME::"
        },
        {
          "name": "OPENAI_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/api-keys:OPENAI_API_KEY::"
        },
        {
          "name": "NAVER_CLIENT_ID",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/api-keys:NAVER_CLIENT_ID::"
        },
        {
          "name": "NAVER_CLIENT_SECRET",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/api-keys:NAVER_CLIENT_SECRET::"
        },
        {
          "name": "KAKAO_REST_API_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/api-keys:KAKAO_REST_API_KEY::"
        },
        {
          "name": "SERVICE_KEY",
          "valueFrom": "arn:aws:secretsmanager:ap-northeast-2:YOUR_ACCOUNT_ID:secret:matetrip/api-keys:SERVICE_KEY::"
        }
      ],
      "command": [
        "sh",
        "-c",
        "python scripts/process_reviews_batch.py --batch $BATCH_INDEX --total-batches $TOTAL_BATCHES"
      ]
    }
  ]
}
